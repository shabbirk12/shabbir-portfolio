# Resend API key — get one at https://resend.com/api-keys
# Used for both the contact form and admin password-reset emails.
RESEND_API_KEY=

# Verified sending address on your Resend domain (shabbirkhan.dev)
CONTACT_FROM_EMAIL=contact@shabbirkhan.dev

# Where contact form submissions land
CONTACT_TO_EMAIL=shabbirk.sk12@gmail.com

# ── Database (required — admin accounts, projects, and site content all
#    live here now, not in JSON files) ────────────────────────────────
# Postgres connection string. Works with Neon, Supabase, Vercel Postgres
# (via Neon), Railway, or any standard Postgres. See EDITING_GUIDE.md for
# setup steps and db/schema.sql for the schema.
DATABASE_URL=

# ── File storage (required for logo upload) ───────────────────────────
# Vercel Blob read/write token — create a Blob store in your Vercel project
# and copy the token it gives you. See EDITING_GUIDE.md.
BLOB_READ_WRITE_TOKEN=

# ── Admin dashboard (/admin) ──────────────────────────────────────────
# Random 32+ character string used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# The public URL of your deployed site — used to build password-reset links
# in emails. Use http://localhost:3000 for local dev.
SITE_URL=http://localhost:3000

# NOTE: there's no ADMIN_USERNAME / ADMIN_PASSWORD_HASH here anymore —
# admin accounts now live in the database. Create the first one with:
#   DATABASE_URL=... SEED_ADMIN_PASSWORD=yourpassword node scripts/seed.mjs
# (see EDITING_GUIDE.md for the full walkthrough)
